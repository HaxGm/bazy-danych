Project wypozyczalnia {
  database_type: 'PostgreSQL'
  Note: 'Wypożyczalnia sprzętu elektronicznego (laptopy, aparaty, projektory, konsole, drony)'
}

// ===== Typy wyliczeniowe =====

Enum equipment_status {
  available
  rented
  maintenance
  retired [note: 'nie można przywrócić do obiegu']
}

Enum payment_method {
  cash
  card
  bank_transfer
  blik
}

Enum payment_type {
  rental_fee
  deposit
  deposit_refund
  penalty
}

// ===== Tabele =====

Table customers {
  customer_id integer [pk, increment]
  first_name varchar(50) [not null, note: 'niepuste']
  last_name varchar(50) [not null, note: 'niepuste']
  address varchar(200) [not null, note: 'adres zamieszkania lub siedziby firmy']
  phone_number varchar(20) [not null, note: '9–15 cyfr, opcjonalny + na początku']
  email varchar(100) [not null, unique, note: 'format adresu e-mail']
  nip varchar(10) [null, unique, note: 'tylko klienci biznesowi; 10 cyfr, poprawna cyfra kontrolna']
  registration_date date [not null, default: `CURRENT_DATE`]

  Note: 'Klienci – osoby prywatne i firmy'
}

Table equipment {
  equipment_id integer [pk, increment]
  name varchar(100) [not null, note: 'nazwa modelu']
  category varchar(50) [not null, note: 'np. laptop, camera, projector, console, drone']
  manufacturer varchar(50) [not null]
  serial_number varchar(50) [not null, unique, note: 'numer seryjny producenta']
  description text [null]
  daily_rate numeric(10,2) [not null, note: '> 0; kopiowana do rental_items przy wypożyczeniu']
  deposit numeric(10,2) [not null, default: 0, note: '>= 0']
  status equipment_status [not null, default: 'available']
  purchase_date date [not null]

  Note: 'Jeden rekord = jeden egzemplarz sprzętu'
}

Table rentals {
  rental_id integer [pk, increment]
  customer_id integer [not null]
  rental_date timestamp(0) [not null, default: `now()`]
  due_date date [not null, note: 'późniejsza niż rental_date; po przekroczeniu naliczana kara']
  return_date timestamp(0) [null, note: 'nie wcześniejsza niż rental_date; NULL dopóki sprzęt nie wróci']
  is_cancelled boolean [not null, default: false, note: 'anulowane nie może mieć return_date']

  Note: 'Wypożyczenie – pakiet, może zawierać wiele egzemplarzy'
}

Table rental_items {
  rental_item_id integer [pk, increment]
  rental_id integer [not null]
  equipment_id integer [not null]
  daily_rate numeric(10,2) [not null, note: '> 0; stawka zapisana w chwili wypożyczenia']
  deposit numeric(10,2) [not null, default: 0, note: '>= 0; kaucja zapisana w chwili wypożyczenia']
  penalty numeric(10,2) [null, note: '>= 0; naliczana automatycznie przy zwrocie']
  return_notes varchar(500) [null, note: 'np. uszkodzenia']
  is_cancelled boolean [not null, default: false]

  indexes {
    (rental_id, equipment_id) [unique]
  }

  Note: 'Pozycje wypożyczenia – tabela łącząca rentals i equipment (M:N)'
}

Table payments {
  payment_id integer [pk, increment]
  rental_id integer [not null]
  payment_date timestamp(0) [not null, default: `now()`]
  amount numeric(10,2) [not null, note: '> 0; kierunek wynika z type']
  method payment_method [not null]
  type payment_type [not null]

  Note: 'Płatności: opłaty, kaucje, zwroty kaucji, kary'
}

// ===== Relacje =====

Ref: rentals.customer_id > customers.customer_id [delete: restrict]
Ref: rental_items.rental_id > rentals.rental_id [delete: cascade]
Ref: rental_items.equipment_id > equipment.equipment_id [delete: restrict]
Ref: payments.rental_id > rentals.rental_id [delete: restrict]
